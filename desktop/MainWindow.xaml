<Window x:Class="InfiniteCanvasDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="无限画布桌面端" Height="760" Width="940" MinHeight="680" MinWidth="820"
        WindowStartupLocation="CenterScreen" Background="{StaticResource PageBackground}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="无限画布" FontSize="28" FontWeight="SemiBold" Foreground="#171717" />
                <TextBlock Text="Windows 桌面启动器 · 复用现有 Web 前端与 Edge 数据" Margin="0,5,0,0" Foreground="{StaticResource MutedBrush}" />
            </StackPanel>
            <Border Grid.Column="1" Background="#E8F5EC" CornerRadius="16" Padding="14,7" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="#D97706" Margin="0,0,8,0" />
                    <TextBlock x:Name="StatusText" Text="正在准备" Foreground="#275D38" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="4*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource PanelBackground}" CornerRadius="12" Padding="20">
                <StackPanel>
                    <TextBlock Text="API 配置" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock Text="API Key 保存到 Windows 凭据管理器，不写入脚本或普通配置文件。" TextWrapping="Wrap" Margin="0,5,0,16" Foreground="{StaticResource MutedBrush}" />
                    <TextBlock Text="Base URL" />
                    <TextBox x:Name="BaseUrlBox" ToolTip="例如 https://api.openai.com" />
                    <TextBlock Text="API Key" />
                    <PasswordBox x:Name="ApiKeyBox" />
                    <TextBlock Text="默认模型" />
                    <TextBox x:Name="ModelBox" ToolTip="例如 gpt-image-2" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Button x:Name="SaveConfigButton" Content="保存配置" Click="SaveConfigButton_Click" Background="{StaticResource PrimaryBrush}" Foreground="White" BorderBrush="{StaticResource PrimaryBrush}" />
                        <TextBlock x:Name="ConfigSavedText" VerticalAlignment="Center" Foreground="#15803D" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource PanelBackground}" CornerRadius="12" Padding="20">
                <StackPanel>
                    <TextBlock Text="服务状态" FontSize="17" FontWeight="SemiBold" />
                    <Grid Margin="0,16,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Vite 地址" Foreground="{StaticResource MutedBrush}" Margin="0,0,18,9" />
                        <TextBlock x:Name="ViteUrlText" Grid.Column="1" Text="http://localhost:3000" Margin="0,0,0,9" />
                        <TextBlock Grid.Row="1" Text="Vite 进程" Foreground="{StaticResource MutedBrush}" Margin="0,0,18,9" />
                        <TextBlock x:Name="ProcessText" Grid.Row="1" Grid.Column="1" Text="未启动" Margin="0,0,0,9" />
                        <TextBlock Grid.Row="2" Text="管理端口" Foreground="{StaticResource MutedBrush}" Margin="0,0,18,9" />
                        <TextBlock x:Name="BridgePortText" Grid.Row="2" Grid.Column="1" Text="-" Margin="0,0,0,9" />
                        <TextBlock Grid.Row="3" Text="数据目录" Foreground="{StaticResource MutedBrush}" Margin="0,0,18,0" />
                        <TextBlock x:Name="DataPathText" Grid.Row="3" Grid.Column="1" TextWrapping="Wrap" />
                    </Grid>
                    <WrapPanel>
                        <Button x:Name="OpenCanvasButton" Content="打开画布" Click="OpenCanvasButton_Click" IsEnabled="False" />
                        <Button x:Name="RestartButton" Content="重新启动服务" Click="RestartButton_Click" IsEnabled="False" />
                        <Button Content="打开日志目录" Click="OpenLogsButton_Click" />
                    </WrapPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#151515" CornerRadius="12" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="运行日志" Foreground="#F5F5F5" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10" />
                <TextBox x:Name="LogBox" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         Background="#151515" Foreground="#D4D4D4" BorderThickness="0" FontFamily="Consolas" FontSize="12" />
            </Grid>
        </Border>
    </Grid>
</Window>
